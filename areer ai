<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Areerr AI Web Interface</title>
    <script src="https://tailwindcss.com"></script>
    <style>
        body { background-color: #0d1117; color: #c9d1d9; }
        .gradient-border {
            border: 1px solid transparent;
            background: linear-gradient(#0d1117, #0d1117) padding-box,
                        linear-gradient(135deg, #58a6ff, #bc8cff) border-box;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col font-sans">

    <!-- App Navigation Header -->
    <header class="border-b border-gray-800 bg-[#161b22] px-6 py-4 flex justify-between items-center">
        <div class="flex items-center space-x-3">
            <span class="text-xl font-black tracking-wider text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-purple-400">AREERR</span>
            <span class="px-2 py-0.5 text-xs rounded bg-purple-900/40 text-purple-300 border border-purple-500/30">LLM-Native</span>
        </div>
        <div class="flex items-center space-x-4">
            <span class="text-xs text-gray-400">Server: production.areerr.ai</span>
            <div class="h-2 w-2 rounded-full bg-green-400 animate-pulse"></div>
        </div>
    </header>

    <!-- Main Workspace Split-Grid -->
    <main class="flex-1 grid grid-cols-1 lg:grid-cols-12 gap-6 p-6">
        
        <!-- Left Column: Core LLM Control & Execution Chat Grid -->
        <section class="lg:col-span-8 flex flex-col bg-[#161b22] rounded-xl border border-gray-800 p-6">
            <div class="flex justify-between items-center mb-4 pb-3 border-b border-gray-800">
                <h2 class="text-sm font-bold uppercase tracking-wider text-gray-400">Agent: intelligenceRouter</h2>
                <span class="text-xs bg-gray-800 px-2 py-1 rounded text-blue-400">Model: reasoningCore (Active)</span>
            </div>
            
            <!-- Chat Output Buffer Terminal -->
            <div class="flex-1 space-y-4 overflow-y-auto mb-4 p-4 bg-[#0d1117] rounded-lg border border-gray-800 max-h-[450px]">
                <div class="flex items-start space-x-3">
                    <div class="bg-purple-600 text-white rounded p-1 text-xs font-bold">SYSTEM</div>
                    <p class="text-sm text-gray-300">Areerr architecture initialized successfully. Agent is bound and listening at production port.</p>
                </div>
            </div>

            <!-- Execution Input Container -->
            <div class="relative">
                <textarea rows="3" class="w-full bg-[#0d1117] border border-gray-700 rounded-lg p-3 text-sm focus:outline-none focus:border-blue-500 text-white placeholder-gray-500 resize-none" placeholder="Query reasoningCore agent..."></textarea>
                <button class="absolute bottom-3 right-3 bg-gradient-to-r from-blue-500 to-purple-600 hover:from-blue-600 hover:to-purple-700 text-white px-4 py-1.5 rounded-md text-xs font-medium tracking-wide transition shadow-lg">
                    Execute Agent
                </button>
            </div>
        </section>

        <!-- Right Column: Authentication & Financial Control Frameworks -->
        <section class="lg:col-span-4 space-y-6">
            
            <!-- System Component Block: Multi-Tenant Sign Options (authGateway) -->
            <div class="bg-[#161b22] rounded-xl border border-gray-800 p-6">
                <h3 class="text-xs font-bold uppercase tracking-wider text-gray-400 mb-4 flex items-center justify-between">
                    <span>Component: authGateway</span>
                    <span class="text-[10px] text-green-400 bg-green-950 px-2 py-0.5 rounded-full border border-green-800">Secure</span>
                </h3>
                
                <div class="space-y-3">
                    <button class="w-full flex items-center justify-center space-x-2 bg-white hover:bg-gray-100 text-black font-medium py-2 px-4 rounded-lg text-sm transition">
                        <svg class="h-4 w-4" viewBox="0 0 24 24"><path fill="currentColor" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/><path fill="currentColor" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path fill="currentColor" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" fill="#FBBC05"/><path fill="currentColor" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" fill="#EA4335"/></svg>
                        <span>Continue with Google</span>
                    </button>
                    
                    <button class="w-full flex items-center justify-center space-x-2 bg-[#24292e] hover:bg-[#2f363d] text-white font-medium py-2 px-4 rounded-lg text-sm border border-gray-700 transition">
                        <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.17 6.839 9.49.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.603-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.464-1.11-1.464-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.831.092-.646.35-1.086.636-1.336-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.579.688.481C19.137 20.167 22 16.418 22 12c0-5.523-4.477-10-10-10z"/></svg>
                        <span>Continue with GitHub</span>
                    </button>
                </div>
                
                <div class="relative flex py-3 items-center">
                    <div class="flex-grow border-t border-gray-800"></div>
                    <span class="flex-shrink mx-4 text-gray-500 text-[11px] uppercase tracking-widest">Or Secure Passkey</span>
                    <div class="flex-grow border-t border-gray-800"></div>
                </div>

                <button class="w-full bg-gradient-to-r from-purple-900/40 to-blue-900/40 hover:from-purple-900/60 hover:to-blue-900/60 text-purple-200 border border-purple-500/30 text-xs py-2 rounded-lg font-medium tracking-wide transition flex items-center justify-center space-x-2">
                    <span>🛡️</span>
                    <span>Authenticate via Native Passkey</span>
                </button>
            </div>

            <!-- System Component Block: Subscription Payments (billingGateway) -->
            <div class="bg-[#161b22] rounded-xl border border-gray-800 p-6 gradient-border">
                <div class="flex justify-between items-center mb-4">
                    <h3 class="text-xs font-bold uppercase tracking-wider text-gray-400">Component: billingGateway</h3>
                    <span class="text-[10px] bg-blue-950 text-blue-400 px-2 py-0.5 rounded border border-blue-900">Stripe Live</span>
                </div>
                
                <div class="space-y-4">
                    <!-- Tier Selection Logic Option -->
                    <div class="border border-purple-500/40 bg-purple-950/20 rounded-lg p-3 relative cursor-pointer">
                        <div class="flex justify-between items-center mb-1">
                            <span class="text-sm font-bold text-white">Tier-Standard</span>
                            <span class="text-sm font-black text-purple-400">$20<span class="text-[10px] text-gray-400 font-normal">/mo</span></span>
                        </div>
                        <p class="text-xs text-gray-400">Access to standard tokens generated by intelligenceRouter.</p>
                        <input type="radio" checked name="plan" class="absolute top-4 right-4 accent-purple-500 hidden">
                    </div>

                    <div class="border border-gray-800 bg-[#0d1117] rounded-lg p-3 opacity-60 hover:opacity-90 transition cursor-pointer">
                        <div class="flex justify-between items-center mb-1">
                            <span class="text-sm font-bold text-white">Tier-Enterprise</span>
                            <span class="text-sm font-black text-blue-400">$150<span class="text-[10px] text-gray-400 font-normal">/mo</span></span>
                        </div>
                        <p class="text-xs text-gray-400">High-throughput compute streams over edgeComputeNode.</p>
                    </div>

                    <!-- Payment Execution Trigger Action Button -->
                    <button class="w-full bg-gradient-to-r from-blue-500 to-purple-500 hover:from-blue-600 hover:to-purple-600 text-white font-bold py-2.5 px-4 rounded-lg text-sm tracking-wide shadow-md transition transform active:scale-[0.99]">
                        Initialize Secure Checkout
                    </button>
                    
                    <p class="text-[10px] text-center text-gray-500">
                        Webhooks monitored securely at: <br><span class="text-gray-400 font-mono">webhooks.areerr.ai/v1/settle</span>
                    </p>
                </div>
            </div>

        </section>
    </main>

    <!-- Global Application Footer Status -->
    <footer class="border-t border-gray-800 bg-[#0d1117] px-6 py-3 text-center text-xs text-gray-500">
        Engine Context Compiled via <span class="font-mono text-gray-400">Areerr IR Transformer v1.0.4</span>
    </footer>

</body>
</html>
